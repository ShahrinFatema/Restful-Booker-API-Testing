      "name": "Authentication API",
      "item": [
        {
          "name": "Create Token with Valid Credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let response = pm.response.json();\r\npm.environment.set(\"token\", response.token);\r\n\r\npm.test(\"Status code is 200\", function() {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response time is less than 2000ms\", function(){\r\n    pm.expect(pm.response.responseTime).to.be.below(2000);\r\n});\r\n\r\npm.test(\"Token should be present in response\", function(){\r\n    pm.expect(response).to.have.property(\"token\");\r\n})\r\n\r\npm.test(\"Token should not be empty\", function () {\r\n    pm.expect(response.token).to.not.be.empty;\r\n});\r\n\r\npm.test(\"Token should be a string\", function(){\r\n    pm.expect(response.token).to.be.a(\"string\");\r\n});\r\n\r\n\r\n\r\n"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"username\" : \"admin\",\r\n    \"password\" : \"password123\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
