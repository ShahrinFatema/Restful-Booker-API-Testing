      "name": "Booking Management API",
      "item": [
        {
          "name": "Create New Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let response = pm.response.json(); \r",
                  "pm.environment.set(\"bookingId\", response.bookingid);\r",
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "pm.test(\"Response time is less than 2000ms\", function () {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
                  "});\r",
                  "let requestBody = JSON.parse (pm.request.body.raw);\r",
                  "pm.environment.set(\"fname\", response.booking.firstname);\r",
                  "pm.test(\"first name matches request\", function(){\r",
                  "    pm.expect(response.booking.firstname).to.eql(requestBody.firstname)\r",
                  "});\r",
                  "pm.environment.set(\"lname\", response.booking.lastname);\r",
                  "pm.test(\"last name matches request\", function(){\r",
                  "    pm.expect(response.booking.lastname).to.eql(requestBody.lastname)\r",
                  "});\r",
                  "pm.environment.set(\"totalprice\", response.booking.totalprice);\r",
                  "pm.test(\"Totalprice matches request\", function(){\r",
                  "    pm.expect(response.booking.totalprice).to.eql(requestBody.totalprice)\r",
                  "});\r",
                  "pm.environment.set(\"dpaid\", response.booking.depositpaid);\r",
                  "pm.test(\"depositpaid matches request\", function(){\r",
                  "    pm.expect(response.booking.depositpaid).to.eql(requestBody.depositpaid)\r",
                  "});\r",
                  "pm.environment.set(\"bookingdates\", response.booking.bookingdates);\r",
                  "pm.test(\"bookingdate matches request\", function(){\r",
                  "    pm.expect(response.booking.bookingdates).to.eql(requestBody.bookingdates)\r",
                  "});\r",
                  "pm.environment.set(\"additionalneeds\", response.booking.additionalneeds);\r",
                  "pm.test(\"additionalneed matches request\", function(){\r",
                  "    pm.expect(response.booking.additionalneeds).to.eql(requestBody.additionalneeds)\r",
                  "});\r",
                  "\r",
                  "\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"firstname\" : \"Shahrin\",\r\n    \"lastname\" : \"Fatema\",\r\n    \"totalprice\" : 111,\r\n    \"depositpaid\" : true,\r\n    \"bookingdates\" : {\r\n        \"checkin\" : \"2018-01-01\",\r\n        \"checkout\" : \"2019-01-01\"\r\n    },\r\n    \"additionalneeds\" : \"Breakfast\"\r\n}",
